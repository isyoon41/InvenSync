{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@ip-review/*": ["packages/*/src"],
      "@ip-review/db": ["packages/db/src"],
      "@ip-review/db/*": ["packages/db/src/*"],
      "@ip-review/domain": ["packages/domain/src"],
      "@ip-review/domain/*": ["packages/domain/src/*"],
      "@ip-review/config": ["packages/config/src"],
      "@ip-review/config/*": ["packages/config/src/*"],
      "@ip-review/mail-ingest": ["packages/mail-ingest/src"],
      "@ip-review/mail-ingest/*": ["packages/mail-ingest/src/*"],
      "@ip-review/kipris-client": ["packages/kipris-client/src"],
      "@ip-review/kipris-client/*": ["packages/kipris-client/src/*"],
      "@ip-review/llm-engine": ["packages/llm-engine/src"],
      "@ip-review/llm-engine/*": ["packages/llm-engine/src/*"],
      "@ip-review/workflows": ["packages/workflows/src"],
      "@ip-review/workflows/*": ["packages/workflows/src/*"],
      "@ip-review/ui": ["packages/ui/src"],
      "@ip-review/ui/*": ["packages/ui/src/*"],
      "@ip-review/observability": ["packages/observability/src"],
      "@ip-review/observability/*": ["packages/observability/src/*"]
    }
  },
  "include": [],
  "exclude": ["node_modules"]
}
