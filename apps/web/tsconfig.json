{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ip-review/db": ["../../packages/db/src"],
      "@ip-review/db/*": ["../../packages/db/src/*"],
      "@ip-review/domain": ["../../packages/domain/src"],
      "@ip-review/domain/*": ["../../packages/domain/src/*"],
      "@ip-review/workflows": ["../../packages/workflows/src"],
      "@ip-review/workflows/*": ["../../packages/workflows/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
